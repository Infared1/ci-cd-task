    "test:verify:text": "wdio run ./configs/chrome.cucumber.conf.js --spec ./test/features/verifyText.feature",
    "test:wiki": "wdio run ./configs/chrome.cucumber.conf.js --spec ./test/features/wiki.feature",
    "test:steam": "wdio run ./configs/chrome.cucumber.conf.js --spec ./test/features/steam.feature",
    "test:weather": "wdio run ./configs/chrome.cucumber.conf.js --spec ./test/features/weather.feature",
    "test:search:game": "wdio run ./configs/chrome.cucumber.conf.js --spec ./test/features/searchGame.feature",
