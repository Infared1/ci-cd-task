    "test:add:remove": "wdio run ./configs/chrome.cucumber.conf.js --spec ./test/features/addRemoveElements.feature",
    "test:auth": "wdio run ./configs/chrome.cucumber.conf.js --spec ./test/features/basicAuth.feature",
